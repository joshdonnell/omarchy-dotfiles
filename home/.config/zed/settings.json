        "external": {
          "command": "/home/josh/.local/bin/js-format",
          "arguments": [
            "{buffer_path}"
          ]
        }
      }
    },
    "Markdown": {
      "formatter": {
        "external": {
          "command": "/home/josh/.local/bin/js-format",
          "arguments": [
            "{buffer_path}"
          ]
        }
      }
    },
    "TypeScript": {
