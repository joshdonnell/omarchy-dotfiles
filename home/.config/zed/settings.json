{
  "cli_default_open_behavior": "existing_window",
  "agent_servers": {
    "cursor": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    }
  },
  "base_keymap": "VSCode",
  "theme": "Catppuccin Frappé",
  "icon_theme": "Catppuccin Frappé",
  "auto_install_extensions": {
    "catppuccin": true,
    "catppuccin-icons": true,
    "php": true,
    "laravel-official": true,
    "blade": true,
    "oxc": true,
    "vue": true
  },
  "buffer_font_family": "Dank Mono",
  "buffer_font_size": 14,
  "ui_font_family": "Dank Mono",
  "terminal": {
    "font_family": "Dank Mono",
    "font_size": 14,
    "font_fallbacks": [
      "JetBrainsMono Nerd Font"
    ],
    "button": false
  },
  "confirm_quit": true,
  "preview_tabs": {
    "enabled": false
  },
  "snippet_sort_order": "top",
  "diff_view_style": "unified",
  "tab_bar": {
    "show": false
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
    "selections_menu": false
  },
  "title_bar": {
    "show_onboarding_banner": false,
    "show_user_picture": false,
    "show_sign_in": false
  },
  "current_line_highlight": "none",
  "selection_highlight": false,
  "lsp_document_colors": "none",
  "inline_code_actions": false,
  "scrollbar": {
    "cursors": false,
    "git_diff": false,
    "selected_text": false,
    "selected_symbol": false,
    "diagnostics": "none"
  },
  "git": {
    "git_gutter": "hide",
    "inline_blame": {
      "enabled": false
    }
  },
  "project_panel": {
    "dock": "right",
    "button": false,
    "git_status": false,
    "show_diagnostics": "off",
    "indent_guides": {
      "show": "never"
    }
  },
  "outline_panel": {
    "dock": "right",
    "button": false
  },
  "git_panel": {
    "dock": "right",
    "button": false
  },
  "collaboration_panel": {
    "button": false
  },
  "agent": {
    "button": false
  },
  "debugger": {
    "button": false
  },
  "diagnostics": {
    "button": false
  },
  "search": {
    "button": false
  },
  "format_on_save": "on",
  "prettier": {
    "allowed": true
  },
  "languages": {
    "PHP": {
      "language_servers": [
        "phpantom",
        "laravel",
        "!intelephense",
        "!phpactor",
        "!phptools",
        "..."
      ],
      "formatter": {
        "external": {
          "command": "/home/josh/.local/bin/php-format",
          "arguments": [
            "{buffer_path}"
          ]
        }
      }
    },
    "CSS": {
      "formatter": {
        "external": {
          "command": "/home/josh/.local/bin/js-format",
          "arguments": [
            "{buffer_path}"
          ]
        }
      }
    },
    "HTML": {
      "formatter": {
        "external": {
          "command": "/home/josh/.local/bin/js-format",
          "arguments": [
            "{buffer_path}"
          ]
        }
      }
    },
    "JavaScript": {
      "formatter": {
        "external": {
          "command": "/home/josh/.local/bin/js-format",
          "arguments": [
            "{buffer_path}"
          ]
        }
      }
    },
    "JSON": {
      "formatter": {
        "external": {
          "command": "/home/josh/.local/bin/js-format",
          "arguments": [
            "{buffer_path}"
          ]
        }
      }
    },
    "JSONC": {
